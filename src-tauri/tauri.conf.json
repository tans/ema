{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMA",
  "version": "0.1.10",
  "identifier": "xin.ema.gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run icons && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Email Agent",
        "width": 800,
        "height": 680,
        "minWidth": 440,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4NzZDRkFCODg5MzJFQkIKUldTN0xwT0lxODkycUs4eVlxN3oveG9DUnBKU2o5L21mRCtNVXhaQmpkRHgyQ09ocHJpbDdMdmEK",
      "endpoints": [
        "https://github.com/tans/ema/releases/latest/download/latest.json"
      ]
    }
  }
}
